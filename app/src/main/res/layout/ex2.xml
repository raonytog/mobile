<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ImageButton
        android:id="@+id/button_top_left"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:scaleType="fitCenter"
        android:src="@drawable/add"
        android:layout_margin="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@id/button_top_right"
        app:tint="@color/design_default_color_primary_dark">
    </ImageButton>

    <ImageButton
        android:id="@+id/button_top_right"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:scaleType="fitCenter"
        android:src="@drawable/avc"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintLeft_toRightOf="@id/button_top_left"
        app:tint="@color/design_default_color_primary_dark">
    </ImageButton>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Olá, Cidadão"
        android:layout_margin="20dp"
        app:layout_constraintTop_toBottomOf="@id/button_top_left"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
    </TextView>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="@id/button_bottom_add"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/button_top_left"
        android:padding="5dp"
        android:text="Insira seu nome"
        android:background="#e8e8e8">
    </EditText>

    <Button
        android:id="@+id/button_bottom_add"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Adicionar"
        android:layout_margin="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:tint="@color/design_default_color_primary_dark">
    </Button>



</androidx.constraintlayout.widget.ConstraintLayout>